{
  "buildCommand": "npx vite build",        // ✅ Direct execution (not npm run)
  "outputDirectory": "dist",
  "installCommand": "npm ci",               // ✅ Clean install (CI standard)
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"          // ✅ SPA routing (fixes 404s)
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
